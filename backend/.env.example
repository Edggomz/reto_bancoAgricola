# ============================================================================
# Ruta · Bancoagrícola — variables de entorno del backend
# ============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# `.env` ya está en .gitignore: NUNCA se sube al repositorio.
#
#   cp .env.example .env
# ============================================================================

# --- Base de datos Oracle ---------------------------------------------------
# XE 21c con arquitectura CDB/PDB: el esquema de la app vive en el PDB (XEPDB1),
# no en el CDB raíz (XE).
ORACLE_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
ORACLE_USER=JULIOPALACIOS
ORACLE_PASSWORD=

# --- Integración de IA (Plan B: Gemini primario + Groq secundario) ----------
# Sin llaves el backend responde con lógica determinista y la demo funciona igual.
# Si la llave de Gemini no tiene formato `AIza...`, poner AI_PRIMARY=groq.
AI_PRIMARY=gemini
AI_SECONDARY=groq
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Notificaciones push (Firebase) ----------------------------------------
# Sin credenciales, los envíos se registran en NOTIFICACION_ENVIADA con estado
# SIMULADO y la demo sigue funcionando.
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/al/service-account.json
FIREBASE_CREDENTIALS_B64=

# Días de anticipación del aviso preventivo (antes del corte).
PUSH_DIAS_AVISO=5
