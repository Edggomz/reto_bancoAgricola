# Copia este archivo a .env. Solo las variables con prefijo EXPO_PUBLIC_ llegan a la app.
#
# Base de la API REST del backend. Si queda vacío, la app arranca igual pero
# muestra el hueco de cada dato, sin pedir nada al servidor.
#
#   Emulador Android : http://localhost:8080/api  y antes  adb reverse tcp:8080 tcp:8080
#   Navegador (web)  : http://localhost:8080/api
#   Celular físico   : http://<ip-de-tu-pc>:8080/api, misma Wi-Fi y puerto 8080 abierto
#
EXPO_PUBLIC_API_URL=http://localhost:8080/api
